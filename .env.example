# Copy to .env and fill in. .env is gitignored.

APP_NAME=HealthSense AI
ENVIRONMENT=development

# SQLite by default (zero setup). Swap to MySQL by changing this ONE line:
DATABASE_URL=sqlite:///./healthsense.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/healthsense

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_PROVIDER=anthropic
